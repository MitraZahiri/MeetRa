{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev"
    },
    {
      "name": "Play in Chrome (phone size)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev",
      "runtimeArgs": ["--window-size=844,430"]
    }
  ]
}
